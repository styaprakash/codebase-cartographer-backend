{
	"info": {
		"name": "Codebase Cartographer API",
		"description": "Complete API collection for the Codebase Cartographer backend MVP.\n\nIncludes: Auth, User, Repositories, Indexing SSE, RAG Chat, Legacy Queries, Semantic Search, Graph & Files, GitHub Webhooks, and Health Check.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "repoId",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "GitHub OAuth Callback",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"githubId\": \"12345678\",\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"accessToken\": \"gho_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/callback",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "callback"]
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "logout"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "User",
			"item": [
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me"]
						}
					},
					"response": []
				},
				{
					"name": "Delete Account",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me"]
						}
					},
					"response": []
				},
				{
					"name": "Delete Indexed Data",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me/data",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me", "data"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Repositories",
			"item": [
				{
					"name": "List Repositories",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/repos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos"]
						}
					},
					"response": []
				},
				{
					"name": "Get Repository by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}"]
						}
					},
					"response": []
				},
				{
					"name": "Create Repository",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"githubRepoId\": \"123456789\",\n  \"name\": \"my-project\",\n  \"fullName\": \"username/my-project\",\n  \"branch\": \"main\",\n  \"language\": \"Java\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/repos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos"]
						}
					},
					"response": []
				},
				{
					"name": "Trigger Repository Indexing",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"my-project\",\n  \"fullName\": \"username/my-project\",\n  \"branch\": \"main\",\n  \"language\": \"Java\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/index",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "index"]
						}
					},
					"response": []
				},
				{
					"name": "Get Indexing Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "status"]
						}
					},
					"response": []
				},
				{
					"name": "Reset Repository Status",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/reset-status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "reset-status"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Indexing SSE",
			"item": [
				{
					"name": "Stream Indexing Events (SSE)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/sse/indexing/{{repoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "sse", "indexing", "{{repoId}}"]
						},
						"description": "Opens an SSE connection to receive real-time indexing progress events.\n\nEvent types:\n- `file_event`: Sent per-file with status, file_path, progress, total_files.\n- `status`: Sent when indexing status changes (INDEXING → INDEXED or FAILED).\n\nThe stream auto-completes when indexing finishes or fails."
					},
					"response": []
				}
			]
		},
		{
			"name": "RAG Chat",
			"item": [
				{
					"name": "Chat with Repository (RAG)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"How does the authentication flow work in this project?\",\n  \"llmProvider\": \"OLLAMA_LLAMA3_1\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/chat/{{repoId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "chat", "{{repoId}}"]
						},
						"description": "Sends a question to the RAG pipeline for a specific repository.\n\nThe `llmProvider` field selects which generative model to use. Available values:\n- OLLAMA_LLAMA3\n- OLLAMA_LLAMA3_1\n- OLLAMA_QWEN2_5\n- OLLAMA_DEEPSEEK_CODER\n- OPENAI_GPT4\n- DEEPSEEK_V4\n\nResponse includes the AI-generated answer and source file citations."
					},
					"response": []
				}
			]
		},
		{
			"name": "Legacy Queries",
			"item": [
				{
					"name": "Ask Repository Question (Legacy)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"question\": \"What does the RepoService do?\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/query",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "query"]
						},
						"description": "Legacy query endpoint from QueryController. Consider using the new RAG Chat endpoint (POST /api/chat/{repoId}) instead."
					},
					"response": []
				},
				{
					"name": "Get Query History",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/queries",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "queries"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Semantic Search",
			"item": [
				{
					"name": "Search Code Chunks",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"authentication filter\",\n  \"threshold\": 0.7,\n  \"limit\": 10\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/search",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "search"]
						},
						"description": "Performs a semantic similarity search on indexed code chunks.\n\n- `query`: The natural language search query.\n- `threshold`: Minimum cosine similarity score (default 0.7).\n- `limit`: Max number of results (default 10)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Graph & Files",
			"item": [
				{
					"name": "Get Dependency Graph",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/graph",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "graph"]
						}
					},
					"response": []
				},
				{
					"name": "Get File Tree",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/repos/{{repoId}}/files",
							"host": ["{{baseUrl}}"],
							"path": ["api", "repos", "{{repoId}}", "files"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "GitHub Webhooks",
			"item": [
				{
					"name": "Handle Push Event",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-Hub-Signature-256",
								"value": "sha256=<computed_hmac_hex>",
								"description": "HMAC-SHA256 signature of the payload using the webhook secret. Required for signature verification."
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"ref\": \"refs/heads/main\",\n  \"repository\": {\n    \"full_name\": \"username/my-project\",\n    \"default_branch\": \"main\"\n  },\n  \"commits\": [\n    {\n      \"id\": \"abc123def456\",\n      \"message\": \"feat: add new search feature\",\n      \"added\": [\"src/main/java/NewFile.java\"],\n      \"modified\": [\"src/main/java/ExistingFile.java\"],\n      \"removed\": [\"src/main/java/OldFile.java\"]\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/webhooks/github/push",
							"host": ["{{baseUrl}}"],
							"path": ["api", "webhooks", "github", "push"]
						},
						"auth": {
							"type": "noauth"
						},
						"description": "Receives GitHub push webhook events for incremental re-indexing.\n\nRequires:\n- `X-Hub-Signature-256` header with HMAC-SHA256 signature.\n- Push must be to the repository's default branch to be processed.\n\nThe controller extracts added/modified/removed files from the commits array and enqueues an incremental indexing job."
					},
					"response": []
				}
			]
		},
		{
			"name": "Health",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"auth": {
							"type": "noauth"
						},
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/?name=World",
							"host": ["{{baseUrl}}"],
							"path": [""],
							"query": [
								{
									"key": "name",
									"value": "World"
								}
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
